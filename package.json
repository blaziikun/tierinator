{
    "name": "tierinator",
    "version": "1.0.0",
    "private": true,
    "description": "Tier lists for anything: your own pictures, characters from any wiki, or a ready-made pack. Runs in the browser; no account.",
    "license": "MIT",
    "type": "module",
    "packageManager": "pnpm@12.15.0",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "lint": "biome check --error-on-warnings",
        "format": "biome check --write",
        "check": "tsc -p . && tsc -p tests",
        "knip": "knip",
        "test:unit": "vitest run",
        "test:e2e": "playwright test --project=desktop --project=phone",
        "test:visual": "playwright test --project=visual-desktop --project=visual-phone",
        "build:test": "vite build --mode test",
        "check:templates": "node scripts/check-template-titles.mjs",
        "guard": "node scripts/identity-guard.ts",
        "verify": "pnpm lint && pnpm check && pnpm knip && pnpm test:unit && pnpm build",
        "deploy": "pnpm verify && wrangler deploy"
    },
    "engines": {
        "node": ">=22"
    },
    "dependencies": {
        "fflate": "0.8.3",
        "jspdf": "4.2.1"
    },
    "devDependencies": {
        "@axe-core/playwright": "4.14.0",
        "@biomejs/biome": "2.6.4",
        "@playwright/test": "1.64.1",
        "@types/node": "22.20.5",
        "knip": "6.44.1",
        "typescript": "6.0.3",
        "vite": "8.3.5",
        "vitest": "5.1.0",
        "wrangler": "4.156.0"
    }
}

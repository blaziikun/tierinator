// wrangler.jsonc — how Cloudflare serves the site (Workers static assets: no server code).
// Deploy: `pnpm deploy`, or automatically on every push to main (docs/hosting.md).
{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "tierinator",
    "compatibility_date": "2026-10-01",
    "assets": {
        // the built site (`pnpm build`), headers from public/_headers
        "directory": "./dist",
        // a mistyped address shows the app (it has only one page)
        "not_found_handling": "single-page-application"
    },
    // tierinator.com is the address (src/brand.ts). tierinator.sayel.dev serves the same site while people move
    // their lists across: lists live in each address's own browser storage, so it stays up until they have
    // (docs/hosting.md {8}). Removing it later is deleting its line here and deploying.
    "routes": [{ "pattern": "tierinator.com", "custom_domain": true }, { "pattern": "tierinator.sayel.dev", "custom_domain": true }],
    // the site is only at those addresses, not also at tierinator.<account>.workers.dev or preview addresses
    "workers_dev": false,
    "preview_urls": false,
    // no usage statistics from wrangler
    "send_metrics": false
}
